# Leave VITE_API_URL unset in development: Vite proxies /api to the backend,
# so the browser stays on a single origin and CORS never comes into play.
#
# For production, set it to the deployed backend URL, e.g.
# VITE_API_URL=https://social-dashboard-api.onrender.com/api
VITE_API_URL=

# Backend URL the dev proxy forwards to.
VITE_PROXY_TARGET=http://localhost:8080
